{%- doc -%}
  Renders the "Pairs With" cross-sell widget: a horizontal, CSS scroll-snap carousel of
  companion products manually assigned by the merchant on the product metafield
  `custom.cross_sell_products` (list.product_reference).

  Placement is the merchant's choice from the theme editor — typically dropped as the next
  sibling after `buy-buttons` inside `product-information`, which satisfies "directly below
  the Add to Cart button" without touching any base theme file.

  Renders nothing on the storefront when the source product has no companions assigned. The
  one exception is `request.design_mode`: an empty metafield still renders a minimal
  placeholder so the block stays selectable and draggable in the theme editor.

  @param {product} closest.product - The product supplying the `custom.cross_sell_products` metafield.
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
  assign source_product = closest.product
  assign companions = source_product.metafields.custom.cross_sell_products.value
  # Filters out the source product itself, which would otherwise let sticky-add-to-cart.js's
  # product-id selector (assets/sticky-add-to-cart.js:368) latch onto this card instead of
  # the real buy box.
  assign companions = companions | reject: 'id', source_product.id
  assign companion_count = companions | size
%}

{% if companion_count > 0 %}
  {%- comment -%} CSS lives in its own asset, not a block-level stylesheet tag, so it can be maintained apart from the Liquid. {%- endcomment -%}
  {{ 'rr-cross-sell.css' | asset_url | stylesheet_tag }}
  <script
    src="{{ 'rr-cross-sell.js' | asset_url }}"
    type="module"
  ></script>

  {% render 'fly-to-cart-styles' %}

  {% style %}
    .cross-sell-{{ block.id }} {
      --cs-per-view: {{ block_settings.products_per_view }};
    }
  {% endstyle %}

  <cross-sell-component
    class="cross-sell cross-sell-{{ block.id }} spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <div class="cross-sell__header">
      <h2 class="cross-sell__heading">{{ block_settings.heading | escape }}</h2>
      {% if companion_count > 1 %}
        <div class="cross-sell__controls">
          <button
            type="button"
            class="cross-sell__arrow"
            ref="previous"
            on:click="/previous"
            aria-controls="CrossSellScroller-{{ block.id }}"
            aria-disabled="true"
            aria-label="{{ 'accessibility.slideshow_previous' | t }}"
          >
            <svg
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M12.5 15L7.5 10L12.5 5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
          <button
            type="button"
            class="cross-sell__arrow"
            ref="next"
            on:click="/next"
            aria-controls="CrossSellScroller-{{ block.id }}"
            aria-disabled="false"
            aria-label="{{ 'accessibility.slideshow_next' | t }}"
          >
            <svg
              viewBox="0 0 20 20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M7.5 5L12.5 10L7.5 15"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>
        </div>
      {% endif %}
    </div>

    <ul
      id="CrossSellScroller-{{ block.id }}"
      class="cross-sell__scroller"
      ref="scroller"
      role="list"
      tabindex="0"
      aria-label="{{ block_settings.heading | escape }}"
    >
      {% for companion in companions limit: block_settings.max_products %}
        <li
          class="cross-sell__item"
          ref="cards[]"
        >
          {% render 'rr-cross-sell-card',
            product: companion,
            block_id: block.id,
            index: forloop.index,
            section_id: section.id,
            show_price: block_settings.show_price
          %}
        </li>
      {% endfor %}
    </ul>
  </cross-sell-component>
{% elsif request.design_mode %}
  {% comment %}
    A block with no rendered DOM can't be selected or dragged in the theme editor, so an empty
    metafield still needs a minimal, inert placeholder here. It deliberately does not reuse the
    `cross-sell-component` tag name / load `rr-cross-sell.js`: the stub's `requiredRefs = ['scroller']`
    would throw a MissingRefError the moment the tag is upgraded, and this placeholder has no
    scroller to give it.
  {% endcomment %}
  {{ 'rr-cross-sell.css' | asset_url | stylesheet_tag }}
  <div
    class="cross-sell cross-sell--empty spacing-style"
    style="{% render 'spacing-style', settings: block_settings %}"
    {{ block.shopify_attributes }}
  >
    <h2 class="cross-sell__heading">{{ block_settings.heading | escape }}</h2>
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.cross_sell",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.cross_sell_source"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.pairs_with"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.product_count",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "products_per_view",
      "label": "t:settings.cards_per_view",
      "min": 1,
      "max": 2,
      "step": 0.1,
      "default": 1.3
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "t:settings.show_price",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.cross_sell",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
